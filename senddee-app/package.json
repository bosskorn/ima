{
  "name": "senddee-app",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "cap:sync": "node scripts/sync-version.mjs && npm run build && npx cap sync android",
    "cap:add": "npx cap add android",
    "android:open": "npx cap open android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/prompt": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "jsbarcode": "^3.12.3",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "vite": "^8.3.8"
  }
}
